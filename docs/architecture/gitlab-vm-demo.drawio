<mxfile host="Electron" type="device">
  <diagram id="gitlab-vm-demo" name="GitLab VM demo">
    <mxGraphModel dx="1600" dy="1140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1140" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="GitLab + Azure Load Testing: verified as-built VM architecture (2026-10-19)" style="text;html=0;align=left;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="15" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="rg" value="Azure Sweden Central | rg-contoso-gitlab-demo | SecurityControl=Ignore (not a blanket policy exemption)" style="swimlane;html=0;startSize=40;rounded=1;fillColor=#f5f9ff;strokeColor=#0078d4;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="250" y="135" width="1310" height="950" as="geometry" />
        </mxCell>
        <mxCell id="vnet" value="Dedicated VNet: 10.74.0.0/16" style="swimlane;html=0;startSize=35;rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;dashed=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="280" y="195" width="1240" height="390" as="geometry" />
        </mxCell>
        <mxCell id="aca" value="Existing Container Apps environment" style="swimlane;html=0;startSize=35;rounded=1;fillColor=#e8f4fd;strokeColor=#0078d4;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="310" y="250" width="530" height="260" as="geometry" />
        </mxCell>
        <mxCell id="vm-subnet" value="Private VM subnet: 10.74.4.0/24" style="swimlane;html=0;startSize=35;rounded=1;fillColor=#f0f7ec;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="890" y="250" width="590" height="260" as="geometry" />
        </mxCell>
        <mxCell id="presenter" value="Presenter / browser / Git&#10;External scripted controller&#10;Local GitLab password + PAT" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="25" y="310" width="205" height="120" as="geometry" />
        </mxCell>
        <mxCell id="public-deps" value="Public Ubuntu package repositories&#10;Official pinned GitLab CE image&#10;Outbound HTTPS only" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1050" y="65" width="430" height="60" as="geometry" />
        </mxCell>
        <mxCell id="proxy" value="gitlab-clean&#10;STATELESS official nginx&#10;ACA TLS + existing hostname&#10;0.25 vCPU / 0.5 GiB&#10;No GitLab data, NFS or root secrets" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#0078d4;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="335" y="315" width="230" height="135" as="geometry" />
        </mxCell>
        <mxCell id="runner" value="Existing gitlab-runner ACA&#10;Protected project shell runner&#10;User-assigned managed identity&#10;Per-job AZURE_CONFIG_DIR&#10;No Azure client secret / DinD" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#0078d4;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="590" y="315" width="220" height="135" as="geometry" />
        </mxCell>
        <mxCell id="gitlab-vm" value="vm-gitlab-demo | 10.74.4.4&#10;Official GitLab CE 19.4.2&#10;Gitaly + PostgreSQL + Redis&#10;Regular D4as_v5: 4 vCPU / 16 GiB&#10;No public IP or inbound SSH&#10;VM-only ReadOnly lock verified" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="920" y="305" width="290" height="145" as="geometry" />
        </mxCell>
        <mxCell id="disk" value="Managed Premium SSD&#10;128 GiB | ext4 | stable UUID&#10;/srv/gitlab/config,data,logs&#10;Fail-closed Docker mount guard&#10;CanNotDelete disk lock" style="shape=cylinder3;whiteSpace=wrap;html=0;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1250" y="310" width="200" height="135" as="geometry" />
        </mxCell>
        <mxCell id="nat" value="Dedicated NAT Gateway + egress-only public IP&#10;Scoped to VM subnet; no inbound VM endpoint" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="960" y="525" width="460" height="45" as="geometry" />
        </mxCell>
        <mxCell id="staging" value="Existing App Service: STAGING SLOT&#10;Actual candidate traffic / server metrics&#10;ZIP artifact with source SHA + pipeline ID" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#0078d4;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="320" y="675" width="310" height="95" as="geometry" />
        </mxCell>
        <mxCell id="production" value="Existing App Service: PRODUCTION&#10;Promotion swaps exact tested slot&#10;No rebuild after green gate" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#0078d4;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="320" y="830" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="plan" value="Existing Linux S1 plan (one worker)&#10;CPU / memory / queue metrics are SHARED&#10;between staging and production" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="950" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="alt" value="Existing Azure Load Testing&#10;Test: contoso-gitlab-transactions&#10;Client p95 / RPS / errors + engine logs&#10;Own MI reads staging + shared-plan metrics&#10;Unchanged p95 &gt; 500ms / errors &gt; 1% gate" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="735" y="665" width="350" height="125" as="geometry" />
        </mxCell>
        <mxCell id="workspace" value="Existing Log Analytics workspace&#10;AppServiceConsoleLogs / HTTPLogs&#10;Source SHA + correlation ID&#10;No new Grafana / LGTM / App Insights stack" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#0078d4;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1160" y="670" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="acr" value="Existing private ACR (admin disabled)&#10;Pinned runner + official nginx image mirror&#10;ACA identities: AcrPull only" style="shape=cylinder3;whiteSpace=wrap;html=0;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#0078d4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1160" y="855" width="340" height="85" as="geometry" />
        </mxCell>
        <mxCell id="backup" value="RETAINED migration evidence / backups&#10;Original Premium Azure Files share&#10;CURRENT post-promotion application tar&#10;Separate config + original secrets backup&#10;Read-only migration source, not live VM storage&#10;Still billable; no deletion without authorization" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="735" y="875" width="350" height="145" as="geometry" />
        </mxCell>
        <mxCell id="caveat" value="Single-node demo, NOT HA. VM lock blocks ARM power/management writes, not guest-OS shutdown or platform failure.&#10;Old stateful ACA revisions must be inactive with ZERO replicas before VM writer starts. No second scenario/reset/promotion." style="text;whiteSpace=wrap;html=0;align=left;fontSize=13;fontColor=#990000;" vertex="1" parent="1">
          <mxGeometry x="280" y="1035" width="1230" height="45" as="geometry" />
        </mxCell>
        <mxCell id="https" value="Existing public HTTPS / Git URLs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#0078d4;" edge="1" parent="1" source="presenter" target="proxy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="jobs" value="Poll jobs + Git HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#0078d4;" edge="1" parent="1" source="runner" target="proxy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="private-http" value="Private HTTP 80&#10;Preserve Host + forwarded HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#0078d4;exitX=1;exitY=0.15;entryX=0;entryY=0.15;" edge="1" parent="1" source="proxy" target="gitlab-vm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="local-storage" value="Persistent block storage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;startArrow=block;strokeColor=#82b366;" edge="1" parent="1" source="gitlab-vm" target="disk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vm-egress" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#9673a6;" edge="1" parent="1" source="gitlab-vm" target="nat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="internet-egress" value="Explicit outbound connectivity" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#9673a6;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="nat" target="public-deps">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="deploy" value="Runner MI: ZIP deployment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#0078d4;" edge="1" parent="1" source="runner" target="staging">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="load-api" value="Runner MI: start/read ALT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#0078d4;" edge="1" parent="1" source="runner" target="alt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="load-traffic" value="Read-only candidate load" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#d79b00;" edge="1" parent="1" source="alt" target="staging">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="promote" value="Green only: exact tested slot swap" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#82b366;" edge="1" parent="1" source="staging" target="production">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="shared" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=none;strokeColor=#d6b656;dashed=1;" edge="1" parent="1" source="production" target="plan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="server-metrics" value="ALT MI: Monitoring Reader" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#d79b00;dashed=1;" edge="1" parent="1" source="alt" target="plan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="request-logs" value="Console / HTTP diagnostics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#0078d4;dashed=1;exitX=1;exitY=1;entryX=0;entryY=1;" edge="1" parent="1" source="staging" target="workspace">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="restore-once" value="ONE-TIME same-version restore&#10;Original secret hashes preserved" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#666666;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=1;" edge="1" parent="1" source="backup" target="gitlab-vm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
