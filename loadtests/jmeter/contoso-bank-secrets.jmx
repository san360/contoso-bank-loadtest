<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Contoso Bank - Key Vault Secrets Demo" enabled="true">
      <stringProp name="TestPlan.comments">Small Azure Load Testing demo plan. BASE_URL and load profile values come from the YAML env block/user.properties. API_KEY is resolved at run time from Key Vault by the __GetSecret call in the "Secret Variables" User Defined Variables element; the secret value is not stored in this script. Do not move that call into a sampler, a header or a listener: Azure Load Testing rejects it there.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="udv_baseUrl" elementType="Argument">
            <stringProp name="Argument.name">udv_baseUrl</stringProp>
            <stringProp name="Argument.value">${__BeanShell( System.getenv("BASE_URL") )}</stringProp>
            <stringProp name="Argument.desc">Target hostname, supplied by the BASE_URL environment variable in the YAML config.</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="accountId" elementType="Argument">
            <stringProp name="Argument.name">accountId</stringProp>
            <stringProp name="Argument.value">${__P(accountId,ACC-1001)}</stringProp>
            <stringProp name="Argument.desc">Demo account identifier. Override with an env/property value when needed.</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <!--
        Azure Load Testing refuses to evaluate __GetSecret inside a sampler or a listener
        (engine log: "__GetSecret function is not allowed in a sampler or a listener").
        An HTTP Header Manager value counts as sampler context because it is resolved on
        every request, so the call must happen here, in a User Defined Variables element,
        which JMeter evaluates once per thread at thread start. Everything downstream then
        references the plain ${udv_apiKey} variable.
      -->
      <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="Secret Variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="udv_apiKey" elementType="Argument">
            <stringProp name="Argument.name">udv_apiKey</stringProp>
            <stringProp name="Argument.value">${__GetSecret(API_KEY)}</stringProp>
            <stringProp name="Argument.desc">API key resolved by Azure Load Testing from the Key Vault secret URI declared as the API_KEY secret parameter.</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </Arguments>
      <hashTree/>

      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults" enabled="true">
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
          <collectionProp name="Arguments.arguments"/>
        </elementProp>
        <stringProp name="HTTPSampler.domain">${udv_baseUrl}</stringProp>
        <stringProp name="HTTPSampler.protocol">https</stringProp>
        <stringProp name="HTTPSampler.connect_timeout">10000</stringProp>
        <stringProp name="HTTPSampler.response_timeout">30000</stringProp>
      </ConfigTestElement>
      <hashTree/>

      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
        <collectionProp name="HeaderManager.headers">
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">Accept</stringProp>
            <stringProp name="Header.value">application/json</stringProp>
          </elementProp>
          <elementProp name="" elementType="Header">
            <stringProp name="Header.name">Authorization</stringProp>
            <stringProp name="Header.value">Bearer ${udv_apiKey}</stringProp>
          </elementProp>
        </collectionProp>
      </HeaderManager>
      <hashTree/>

      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Secrets Demo Customers" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <intProp name="LoopController.loops">-1</intProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(threads,5)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(rampup,15)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(duration,60)}</stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">false</boolProp>
      </ThreadGroup>
      <hashTree>
        <!--
          Proves the secret actually arrived in the engine before any traffic is judged.
          It reads the variable only; calling __GetSecret from here would be rejected for
          the same reason it is rejected in a header. Normal runs log only the value
          length and a truncated SHA-256 fingerprint. DEMO_LOG_SECRET=true explicitly
          opts into logging a disposable demo value on the first thread of each engine.
        -->
        <OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="Secret Check" enabled="true"/>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="SecretResolutionCheck" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.security.MessageDigest

String raw = vars.get('udv_apiKey')
String placeholder = '$' + '{'
boolean resolved = raw != null &amp;&amp; raw.trim().length() > 0 &amp;&amp; !raw.contains(placeholder) &amp;&amp; raw != 'API_KEY'

SampleResult.setDataType('text')

if (resolved) {
    byte[] hash = MessageDigest.getInstance('SHA-256').digest(raw.getBytes('UTF-8'))
    String fingerprint = hash.encodeHex().toString().substring(0, 8)
    String msg = 'Key Vault secret API_KEY resolved. length=' + raw.length() + ' sha256_prefix=' + fingerprint
    log.warn(msg)
    if ('true'.equalsIgnoreCase(System.getenv('DEMO_LOG_SECRET')) &amp;&amp; vars.getThreadNum() == 0) {
        log.warn('DEMO ONLY: retrieved API_KEY={}', raw)
    }
    SampleResult.setResponseData(msg, 'UTF-8')
    SampleResult.setResponseCodeOK()
    SampleResult.setResponseMessageOK()
    SampleResult.setSuccessful(true)
} else {
    String detail = (raw == null) ? 'the udv_apiKey variable is null' : ('the value is still an unresolved placeholder of length ' + raw.length())
    String msg = 'Key Vault secret API_KEY was NOT resolved: ' + detail + '. Check that the test secret parameter is named API_KEY, that its value is a valid Key Vault secret URI, that the Key Vault reference identity is set, and that this identity holds Key Vault Secrets User on the vault.'
    log.error(msg)
    SampleResult.setResponseData(msg, 'UTF-8')
    SampleResult.setResponseCode('500')
    SampleResult.setResponseMessage('Secret not resolved')
    SampleResult.setSuccessful(false)
}</stringProp>
          </JSR223Sampler>
          <hashTree/>
        </hashTree>

        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GetBalanceWithSecretHeader" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.path">/api/accounts/${accountId}/balance</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert Balance 200" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Balance request did not return 200</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
        </hashTree>

        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="HealthCheckWithSecretHeader" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
            <collectionProp name="Arguments.arguments"/>
          </elementProp>
          <stringProp name="HTTPSampler.path">/health</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert Health 200" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">200</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Health request did not return 200</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
