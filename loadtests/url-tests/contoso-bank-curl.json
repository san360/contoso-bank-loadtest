{
  "version": "1.0",
  "scenarios": {
    "requestGroup1": {
      "requests": [
        {
          "requestName": "Health",
          "requestType": "CURL",
          "curlCommand": "curl --request GET 'https://app-loadtest-27d2e5.azurewebsites.net/health'",
          "responseVariables": []
        },
        {
          "requestName": "GetBalance",
          "requestType": "CURL",
          "curlCommand": "curl --request GET 'https://app-loadtest-27d2e5.azurewebsites.net/api/accounts/ACC-1001/balance'",
          "responseVariables": []
        },
        {
          "requestName": "GetTransactions",
          "requestType": "CURL",
          "curlCommand": "curl --request GET 'https://app-loadtest-27d2e5.azurewebsites.net/api/accounts/ACC-1001/transactions?page_size=20'",
          "responseVariables": []
        },
        {
          "requestName": "CreateTransfer",
          "requestType": "CURL",
          "curlCommand": "curl --request POST 'https://app-loadtest-27d2e5.azurewebsites.net/api/transfers' --header 'Content-Type: application/json' --data '{\"from_account\":\"ACC-1001\",\"to_account\":\"ACC-2002\",\"amount_minor\":1,\"currency\":\"GBP\",\"reference\":\"CURL-TEST\"}'",
          "responseVariables": [
            {
              "extractorType": "JSONExtractor",
              "expression": "$.transaction_id",
              "variableName": "curlTransferId"
            }
          ]
        },
        {
          "requestName": "GetTransferById",
          "requestType": "CURL",
          "curlCommand": "curl --request GET 'https://app-loadtest-27d2e5.azurewebsites.net/api/transfers/${curlTransferId}' --header 'Accept: application/json'",
          "responseVariables": []
        },
        {
          "requestName": "GenerateStatement",
          "requestType": "CURL",
          "curlCommand": "curl --request GET 'https://app-loadtest-27d2e5.azurewebsites.net/api/statements/ACC-1001?months=3'",
          "responseVariables": []
        }
      ],
      "csvDataSetConfigList": []
    }
  },
  "testSetup": [
    {
      "scenario": "requestGroup1",
      "loadType": "Linear",
      "virtualUsersPerEngine": 50,
      "rampUpTimeInSeconds": 30,
      "durationInSeconds": 180
    }
  ]
}
