# =============================================================================
# Contoso Bank - repository hygiene
# =============================================================================
# This kit is meant to be portable and safe to publish. Keep generated files,
# local environments and cloud state out of source control.
# =============================================================================

# -----------------------------------------------------------------------------
# Python local environments and build artefacts
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Virtual environments are machine-specific. The checked-out src/.venv observed
# in this workspace contains Windows ARM64 Python binaries, so it must not be
# shared with customers or CI runners.
.venv/
venv/
env/
src/.venv/

# Deployments may create this transient root-level virtual environment while
# packaging or validating the demo app. It is disposable.
.venv-tmp/

# -----------------------------------------------------------------------------
# Azure Developer CLI local state
# -----------------------------------------------------------------------------
# azd stores subscription IDs, resource names and per-environment settings here.
# These files describe a live tenant/subscription and should stay local.
.azure/

# -----------------------------------------------------------------------------
# Terraform local state and plans
# -----------------------------------------------------------------------------
# Terraform state can contain provider-returned secret values in plaintext
# (connection strings, access keys, generated passwords, etc.). Never commit it,
# including backups and local plugin caches.
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
*.tfvars
!*.tfvars.example

# -----------------------------------------------------------------------------
# Secrets, certificates and local environment overrides
# -----------------------------------------------------------------------------
*.env
.env
.env.*
!.env.example
*.pfx
*.pem
*.key
*.crt
*.cer
*.p12
*.publishsettings
secrets.json

# -----------------------------------------------------------------------------
# Azure Load Testing and local validation output
# -----------------------------------------------------------------------------
results/
loadTest/
loadtest-results/
loadtests/results/
*.jtl
*.csv.gz

# End-to-end validation output (tools/e2e-test.ps1).
.e2e-results/

# Run artefacts downloaded by tools/run_loadtest.ps1 / .sh (--download).
.loadtest-results/

# Local CLI demo output: downloaded logs/results may contain sensitive test data.
.loadtest-demo/

# Scratch test configs generated by tools/e2e-test.ps1. The script removes
# these on exit, including on Ctrl-C; this is a safety net so an interrupted
# run can never commit a config with no failureCriteria.
loadtests/config/_*.yaml

# -----------------------------------------------------------------------------
# Logs, editor settings and OS cruft
# -----------------------------------------------------------------------------
*.log
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
